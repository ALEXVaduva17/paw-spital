@model IEnumerable<PawSpital.Models.Departament>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Departamente";
    var isAdmin = string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<h1>Listă Departamente (- Test CRUD Bază de Date -)</h1>

@if (isAdmin)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Adaugă Departament Nou</a>
    </p>
}
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nume)</th>
            <th>@Html.DisplayNameFor(model => model.Descriere)</th>
            <th>Operațiuni Valabile</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">Baza de date este goală. Apasă butonul de mai sus pentru a adăuga date.</td></tr>
        }
        @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nume)</td>
            <td>@Html.DisplayFor(modelItem => item.Descriere)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalii (Read)</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modifică (Update)</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Șterge (Delete)</a>
                }
            </td>
        </tr>
        }
    </tbody>
</table>
