@model PawSpital.Models.Departament

@{
    ViewData["Title"] = "Șterge";
}

<h1 class="text-danger">Ștergere Definitivă (- Test Delete -)</h1>
<h3>Ești sigur că vrei să ștergi acest departament din baza de date?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Numele:</dt>
        <dd class="col-sm-9 text-danger fw-bold">@Html.DisplayFor(model => model.Nume)</dd>
        
        <dt class="col-sm-3">Descrierea:</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descriere)</dd>
    </dl>

    <!-- La apăsare pe buton, se va face POST DeleteConfirmed către controller -->
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Da, Șterge definitiv!" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Nu, am greșit (Anulează)</a>
    </form>
</div>
