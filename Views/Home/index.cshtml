@{
    ViewData["Title"] = "Acasă";
}

<div class="p-4 p-md-5 mb-4 rounded-3" style="background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%); color: white;">
    <div class="container-fluid py-4">
        <h1 class="display-4 fw-bold">🏥 Bine ați venit la SanaMed</h1>
        <p class="col-md-8 fs-5 mt-3">
            Spitalul de încredere pentru sănătatea dumneavoastră și a familiei.
            Oferim servicii medicale complete, echipă de specialiști dedicați și programări online rapide.
        </p>
        <div class="mt-4">
            <a class="btn btn-light btn-lg me-2" asp-controller="Home" asp-action="Programari">
                📅 Programare Online
            </a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Home" asp-action="Doctori">
                👨‍⚕️ Echipa Medicală
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="display-4 mb-3">🏥</div>
                <h5 class="card-title fw-bold">Servicii Complete</h5>
                <p class="card-text text-muted">
                    De la consultații generale la investigații de specialitate.
                    Echipamente medicale de ultimă generație.
                </p>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Servicii">Vezi Serviciile</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="display-4 mb-3">👨‍⚕️</div>
                <h5 class="card-title fw-bold">Doctori Specializați</h5>
                <p class="card-text text-muted">
                    O echipă de medici cu experiență vastă, dedicați sănătății
                    și bunăstării pacienților noștri.
                </p>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Doctori">Cunoaște Echipa</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="display-4 mb-3">📋</div>
                <h5 class="card-title fw-bold">Programare Rapidă</h5>
                <p class="card-text text-muted">
                    Programează o vizită online în câteva secunde.
                    Alege doctorul și serviciul dorit.
                </p>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Programari">Programează Acum</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">🏢 Departamente</h4>
                <p class="text-muted">
                    Spitalul nostru dispune de departamente specializate: Cardiologie, Neurologie,
                    Ortopedie, Pediatrie, Dermatologie și Oftalmologie — fiecare echipat la standarde moderne.
                </p>
                <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="Departamente">Explorează Departamentele</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">📞 Contact Rapid</h4>
                <p class="text-muted">
                    Aveți întrebări? Echipa noastră de suport vă stă la dispoziție.
                    Ne puteți contacta telefonic, prin email sau direct la recepția spitalului.
                </p>
                <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="Contact">Contactează-ne</a>
            </div>
        </div>
    </div>
</div>
