@model IEnumerable<PawSpital.Models.Departament>
@{
    ViewData["Title"] = "Departamente";
}

<h1>Departamente</h1>
<p class="text-muted">Structura medicala a spitalului.</p>

<div class="row g-3">
    @foreach (var d in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@d.Nume</h5>
                    <p class="card-text text-muted">@(string.IsNullOrWhiteSpace(d.Descriere) ? "Fara descriere." : d.Descriere)</p>
                </div>
            </div>
        </div>
    }
</div>


