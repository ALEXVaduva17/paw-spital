@model IEnumerable<PawSpital.Models.Serviciu>
@{
    ViewData["Title"] = "Servicii";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Servicii Medicale</h1>
        <p class="text-muted mb-0">Serviciile disponibile in cadrul spitalului.</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var s in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@s.Nume</h5>
                    <p class="card-text text-muted">@s.Descriere</p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <span class="badge text-bg-primary">@s.Pret.ToString("0.00") RON</span>
                    <a asp-action="Programari" asp-controller="Home" class="btn btn-sm btn-outline-primary">Programeaza-te</a>
                </div>
            </div>
        </div>
    }
</div>


