@model PawSpital.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Înregistrare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Creează un cont nou pe platforma medicală SanaMed" />
    <title>Înregistrare - SanaMed</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<a href="/" class="auth-back">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    Acasă
</a>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg width="52" height="52" viewBox="0 0 52 52" fill="none">
                    <rect x="2" y="2" width="48" height="48" rx="14" fill="url(#regGrad)" />
                    <path d="M22 14h8v24h-8z" fill="white" opacity="0.95"/>
                    <path d="M14 22h24v8H14z" fill="white" opacity="0.95"/>
                    <defs>
                        <linearGradient id="regGrad" x1="0" y1="0" x2="52" y2="52">
                            <stop offset="0%" stop-color="#0077b6"/>
                            <stop offset="100%" stop-color="#00b4d8"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <h2>SanaMed</h2>
            <p>Creează un cont nou</p>
        </div>

        <form asp-action="Register" asp-controller="Home" method="post">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <input asp-for="FullName" type="text" placeholder="Nume complet" autocomplete="name" id="register-fullname" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                </svg>
                <input asp-for="Email" type="email" placeholder="Adresa de email" autocomplete="email" id="register-email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <input asp-for="Password" type="password" placeholder="Parolă (min. 6 caractere)" autocomplete="new-password" id="register-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    <polyline points="10 16 12 18 14 16" opacity="0.6"/>
                </svg>
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirmă parola" autocomplete="new-password" id="register-confirm" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="auth-btn" id="register-submit">Creează cont</button>
        </form>

        <div class="auth-links">
            <p style="color: var(--text-muted-auth);">Ai deja cont? <a asp-action="Login" asp-controller="Home">Autentifică-te</a></p>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
