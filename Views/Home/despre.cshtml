@{
    ViewData["Title"] = "Despre";
}

<div class="p-4 p-md-5 mb-4 rounded-3 bg-light">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">Despre SanaMed</h1>
        <p class="col-md-9 fs-6">
            SanaMed este o platformă modernă de prezentare și interacțiune pentru pacienți:
            explorare servicii medicale, echipa de medici specialiști și trimitere programări online.
        </p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5>Misiune</h5><p class="mb-0">Îngrijire medicală accesibilă, profesională și transparentă pentru fiecare pacient.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5>Viziune</h5><p class="mb-0">Digitalizarea completă a interacțiunii cu pacienții pentru o experiență modernă.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5>Valori</h5><p class="mb-0">Empatie, profesionalism, siguranță și inovație în serviciile medicale.</p></div></div></div>
</div>
