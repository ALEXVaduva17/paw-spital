@{ Layout = null; }
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Spital - Programări</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href='/css/styles.css' />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
      <a class="navbar-brand" href='/Home/Index'>Spital</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href='/Home/Index'>Acasă</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/servicii'>Servicii</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/doctori'>Doctori</a></li>
          <li class="nav-item"><a class="nav-link active" href='/Home/programari'>Programări</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/departamente'>Departamente</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/contact'>Contact</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/despre'>Despre</a></li>
        </ul>
        <div class="d-flex align-items-center user-info">
          <span class="me-2">Utilizator: <strong id="user-name"></strong></span>
          <span class="me-3">(<span id="user-email"></span>)</span>
          <a class="btn btn-outline-primary btn-sm me-2" href='/Home/profil'>Profil</a>
          <a class="btn btn-outline-secondary btn-sm me-2" href='/Home/login'>Login</a>
          <a class="btn btn-secondary btn-sm" href='/Home/register'>Register</a>
        </div>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <h1>Programări</h1>
      <p class="text-muted">Formular simplu pentru programare la spital.</p>
    </div>

    <section class="page-section">
      <form class="row g-3">
        <div class="col-md-6">
          <label for="pacient-nume" class="form-label">Nume pacient</label>
          <input type="text" class="form-control" id="pacient-nume" placeholder="Ex: Popescu Ion" />
        </div>
        <div class="col-md-6">
          <label for="serviciu" class="form-label">Serviciu</label>
          <select id="serviciu" class="form-select">
            <option selected>Alege...</option>
            <option>Consultație generală</option>
            <option>Analize de laborator</option>
            <option>Radiologie</option>
          </select>
        </div>
        <div class="col-md-6">
          <label for="data" class="form-label">Data</label>
          <input type="date" class="form-control" id="data" />
        </div>
        <div class="col-md-6">
          <label for="ora" class="form-label">Ora</label>
          <input type="time" class="form-control" id="ora" />
        </div>
        <div class="col-12">
          <label for="observatii" class="form-label">Observații</label>
          <textarea class="form-control" id="observatii" rows="3"></textarea>
        </div>
        <div class="col-12">
          <button type="button" class="btn btn-primary">Salvează programarea (simulare)</button>
        </div>
      </form>
    </section>
  </main>

  <footer class="text-center">
    <small>&copy; 2026 Spital Demo</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src='/js/script.js'></script>
</body>
</html>


