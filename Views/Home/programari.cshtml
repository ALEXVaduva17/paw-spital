@model PawSpital.Models.PublicProgramareViewModel
@{
    ViewData["Title"] = "Programare online";
}

<h1>Programare Online</h1>
<p class="text-muted">Completeaza formularul pentru a trimite o cerere de programare.</p>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Programari" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NumePacient" class="form-label"></label>
                    <input asp-for="NumePacient" class="form-control" />
                    <span asp-validation-for="NumePacient" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DoctorId" class="form-label"></label>
                    <select asp-for="DoctorId" asp-items="ViewBag.DoctorId" class="form-select"></select>
                    <span asp-validation-for="DoctorId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ServiciuId" class="form-label"></label>
                    <select asp-for="ServiciuId" asp-items="ViewBag.ServiciuId" class="form-select"></select>
                    <span asp-validation-for="ServiciuId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Data" class="form-label"></label>
                    <input asp-for="Data" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Trimite programarea</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


