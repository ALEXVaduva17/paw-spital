@model PawSpital.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Autentificare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Autentificare în platforma medicală SanaMed" />
    <title>Autentificare - SanaMed</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<a href="/" class="auth-back">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    Acasă
</a>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon">
                <svg width="52" height="52" viewBox="0 0 52 52" fill="none">
                    <rect x="2" y="2" width="48" height="48" rx="14" fill="url(#loginGrad)" />
                    <path d="M22 14h8v24h-8z" fill="white" opacity="0.95"/>
                    <path d="M14 22h24v8H14z" fill="white" opacity="0.95"/>
                    <defs>
                        <linearGradient id="loginGrad" x1="0" y1="0" x2="52" y2="52">
                            <stop offset="0%" stop-color="#0077b6"/>
                            <stop offset="100%" stop-color="#00b4d8"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <h2>SanaMed</h2>
            <p>Autentifică-te în contul tău</p>
        </div>

        <form asp-action="Login" asp-controller="Home" method="post">
            <div asp-validation-summary="All"></div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                </svg>
                <input asp-for="Email" type="email" placeholder="Adresa de email" autocomplete="email" id="login-email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="auth-input-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <input asp-for="Password" type="password" placeholder="Parola" autocomplete="current-password" id="login-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="auth-btn" id="login-submit">Autentificare</button>
        </form>

        <div class="auth-links">
            <p style="color: var(--text-muted-auth);">Nu ai cont? <a asp-action="Register" asp-controller="Home">Înregistrează-te</a></p>
        </div>

        <div class="auth-demo">
            <p style="margin-bottom: 6px;"><strong>Conturi de test:</strong></p>
            <p style="margin-bottom: 4px;">Admin: <code>admin@sanamed.ro</code> / <code>Admin123!</code></p>
            <p>User: <code>user@sanamed.ro</code> / <code>User123!</code></p>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
