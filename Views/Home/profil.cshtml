@{
    ViewData["Title"] = "Profil";
}

<h1>Profil utilizator</h1>
<p class="text-muted">Datele contului autentificat în sesiunea curentă.</p>

<div class="card" style="max-width: 460px;">
    <div class="card-body">
        <h5 class="card-title">Date personale</h5>
        <p class="card-text"><strong>Nume:</strong> @ViewData["ProfileName"]</p>
        <p class="card-text"><strong>Email:</strong> @ViewData["ProfileEmail"]</p>
        <p class="card-text"><strong>Rol:</strong> @ViewData["ProfileRole"]</p>
    </div>
</div>


