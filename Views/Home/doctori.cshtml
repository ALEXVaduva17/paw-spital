@model IEnumerable<PawSpital.Models.Doctor>
@{
    ViewData["Title"] = "Doctori";
}

<h1>Echipa Medicala</h1>
<p class="text-muted">Medici si specializarile disponibile.</p>

<div class="row g-3">
    @foreach (var d in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@d.Nume</h5>
                    <p class="mb-1"><strong>Specializare:</strong> @d.Specializare</p>
                    <p class="text-muted mb-0"><strong>Departament:</strong> @(d.Departament?.Nume ?? "-")</p>
                </div>
                <div class="card-footer bg-white border-0">
                    <a asp-controller="Home" asp-action="Programari" class="btn btn-outline-primary btn-sm">Rezerva consultatie</a>
                </div>
            </div>
        </div>
    }
</div>


