@{ Layout = null; }
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Spital - Doctori</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href='/css/styles.css' />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
      <a class="navbar-brand" href='/Home/Index'>Spital</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href='/Home/Index'>Acasă</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/servicii'>Servicii</a></li>
          <li class="nav-item"><a class="nav-link active" href='/Home/doctori'>Doctori</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/programari'>Programări</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/departamente'>Departamente</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/contact'>Contact</a></li>
          <li class="nav-item"><a class="nav-link" href='/Home/despre'>Despre</a></li>
        </ul>
        <div class="d-flex align-items-center user-info">
          <span class="me-2">Utilizator: <strong id="user-name"></strong></span>
          <span class="me-3">(<span id="user-email"></span>)</span>
          <a class="btn btn-outline-primary btn-sm me-2" href='/Home/profil'>Profil</a>
          <a class="btn btn-outline-secondary btn-sm me-2" href='/Home/login'>Login</a>
          <a class="btn btn-secondary btn-sm" href='/Home/register'>Register</a>
        </div>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <h1>Doctori</h1>
      <p class="text-muted">Listă simplă de doctori și specializările lor.</p>
    </div>

    <section class="page-section">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Nume</th>
            <th>Specializare</th>
            <th>Departament</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Dr. Ionescu Maria</td>
            <td>Medic de familie</td>
            <td>Ambulatoriu</td>
          </tr>
          <tr>
            <td>Dr. Popa Andrei</td>
            <td>Cardiologie</td>
            <td>Cardiologie</td>
          </tr>
          <tr>
            <td>Dr. Georgescu Elena</td>
            <td>Pediatrie</td>
            <td>Pediatrie</td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>

  <footer class="text-center">
    <small>&copy; 2026 Spital Demo</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src='/js/script.js'></script>
</body>
</html>


