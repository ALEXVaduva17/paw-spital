@model PawSpital.Models.Serviciu

@{
    ViewData["Title"] = "Detalii Serviciu";
}

<h1>Detalii Serviciu</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nume)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Nume)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Pret)</dt>
    <dd class="col-sm-9">@Model.Pret.ToString("0.00")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Descriere)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Descriere)</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifică</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Înapoi la listă</a>
</div>

