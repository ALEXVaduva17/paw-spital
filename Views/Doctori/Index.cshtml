@model IEnumerable<PawSpital.Models.Doctor>

@{
    ViewData["Title"] = "Doctori";
    var isAdmin = User.IsInRole("Admin");
}

<div class="admin-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="h2 text-dark font-weight-bold mb-1">Doctori</h1>
        <p class="text-muted mb-0">Gestionarea și vizualizarea cadrelor medicale și a specializărilor.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Adaugă Doctor</span>
        </a>
    }
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nume)</th>
                    <th>@Html.DisplayNameFor(model => model.Specializare)</th>
                    <th>Departament</th>
                    <th class="text-end">Operațiuni</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="mb-2 text-secondary opacity-50">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <p class="mb-0">Baza de date este goală. Apasă butonul de mai sus pentru a adăuga date.</p>
                        </td>
                    </tr>
                }
                @foreach (var item in Model) {
                <tr>
                    <td class="font-weight-semibold" style="font-weight: 600;">@Html.DisplayFor(_ => item.Nume)</td>
                    <td>
                        <span class="badge bg-light text-primary px-3 py-2" style="border-radius: 6px; font-weight: 500; font-size: 0.85rem;">
                            @Html.DisplayFor(_ => item.Specializare)
                        </span>
                    </td>
                    <td class="text-secondary font-weight-medium">@(item.Departament?.Nume ?? "-")</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2 justify-content-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info admin-btn-action">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <span>Detalii</span>
                            </a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning admin-btn-action">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                    <span>Modifică</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger admin-btn-action">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    <span>Șterge</span>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
