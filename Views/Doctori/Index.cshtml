@model IEnumerable<PawSpital.Models.Doctor>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Doctori";
    var isAdmin = string.Equals(Context.Session.GetString("UserRole"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<h1>Listă Doctori (- CRUD Bază de Date -)</h1>

@if (isAdmin)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Adaugă Doctor Nou</a>
    </p>
}

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nume)</th>
            <th>@Html.DisplayNameFor(model => model.Specializare)</th>
            <th>Departament</th>
            <th>Operațiuni</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">
                    Baza de date este goală. Apasă butonul de mai sus pentru a adăuga date.
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Nume)</td>
                <td>@Html.DisplayFor(_ => item.Specializare)</td>
                <td>@(item.Departament?.Nume ?? "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalii</a>
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modifică</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Șterge</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

