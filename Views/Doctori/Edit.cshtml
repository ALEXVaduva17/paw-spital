@model PawSpital.Models.Doctor

@{
    ViewData["Title"] = "Editare Doctor";
}

<div class="form-card">
    <div class="form-card-title d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Editează Doctor</span>
    </div>
    
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="border-radius: 10px;"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group-custom">
            <label asp-for="Nume"></label>
            <input asp-for="Nume" class="form-control" />
            <span asp-validation-for="Nume" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="form-group-custom">
            <label asp-for="Specializare"></label>
            <input asp-for="Specializare" class="form-control" />
            <span asp-validation-for="Specializare" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="form-group-custom">
            <label asp-for="DepartamentId">Departament</label>
            <select asp-for="DepartamentId" class="form-select" asp-items="ViewBag.DepartamentId"></select>
            <span asp-validation-for="DepartamentId" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Înapoi la Listă</span>
            </a>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Salvează</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
