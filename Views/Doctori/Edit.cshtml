@model PawSpital.Models.Doctor

@{
    ViewData["Title"] = "Editare Doctor";
}

<h1>Editează Doctor</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nume" class="control-label"></label>
                <input asp-for="Nume" class="form-control" />
                <span asp-validation-for="Nume" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Specializare" class="control-label"></label>
                <input asp-for="Specializare" class="form-control" />
                <span asp-validation-for="Specializare" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DepartamentId" class="control-label">Departament</label>
                <select asp-for="DepartamentId" class="form-select" asp-items="ViewBag.DepartamentId"></select>
                <span asp-validation-for="DepartamentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Salvează modificările" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Înapoi la Listă</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

