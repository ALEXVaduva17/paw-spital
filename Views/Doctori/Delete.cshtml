@model PawSpital.Models.Doctor

@{
    ViewData["Title"] = "Șterge Doctor";
}

<div class="delete-card">
    <div class="delete-card-title d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-danger">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Ștergere Definitivă</span>
    </div>
    
    <p class="text-secondary mb-4">Ești sigur că vrei să ștergi acest doctor din baza de date? Această acțiune este ireversibilă.</p>
    
    <div class="border-top border-bottom py-3 my-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-secondary" style="font-weight: 600;">@Html.DisplayNameFor(m => m.Nume)</dt>
            <dd class="col-sm-9 text-danger font-weight-bold" style="font-weight: 600;">@Html.DisplayFor(m => m.Nume)</dd>
            
            <dt class="col-sm-3 text-secondary mt-2" style="font-weight: 600;">@Html.DisplayNameFor(m => m.Specializare)</dt>
            <dd class="col-sm-9 mt-2 text-dark">@Html.DisplayFor(m => m.Specializare)</dd>
            
            <dt class="col-sm-3 text-secondary mt-2" style="font-weight: 600;">Departament</dt>
            <dd class="col-sm-9 mt-2 text-dark">@(Model.Departament?.Nume ?? "-")</dd>
        </dl>
    </div>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Anulează</span>
            </a>
            <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2 px-4 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Da, Șterge</span>
            </button>
        </div>
    </form>
</div>
