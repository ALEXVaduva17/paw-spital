@model PawSpital.Models.Programare

@{
    ViewData["Title"] = "Adaugă Programare";
}

<div class="form-card" style="max-width: 750px;">
    <div class="form-card-title d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Creează Programare Nouă</span>
    </div>
    
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="border-radius: 10px;"></div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="NumePacient"></label>
                    <input asp-for="NumePacient" class="form-control" placeholder="Ex: Popescu Ion" />
                    <span asp-validation-for="NumePacient" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="Telefon"></label>
                    <input asp-for="Telefon" class="form-control" placeholder="Ex: 0722123456" />
                    <span asp-validation-for="Telefon" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="DoctorId">Doctor</label>
                    <select asp-for="DoctorId" asp-items="ViewBag.DoctorId" class="form-select"></select>
                    <span asp-validation-for="DoctorId" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="ServiciuId">Serviciu</label>
                    <select asp-for="ServiciuId" asp-items="ViewBag.ServiciuId" class="form-select"></select>
                    <span asp-validation-for="ServiciuId" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="SalaId">Sală (opțional)</label>
                    <select asp-for="SalaId" asp-items="ViewBag.SalaId" class="form-select">
                        <option value="">-- fără sală --</option>
                    </select>
                    <span asp-validation-for="SalaId" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="Data"></label>
                    <input asp-for="Data" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Data" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>
        
        <div class="form-group-custom">
            <label asp-for="Status"></label>
            <input asp-for="Status" class="form-control" placeholder="Ex: În așteptare, Confirmată" />
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Înapoi la Listă</span>
            </a>
            <button type="submit" class="btn btn-success d-inline-flex align-items-center gap-2 px-4 py-2" style="border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Salvează</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
