@model PawSpital.Models.Programare

@{
    ViewData["Title"] = "Detalii Programare";
}

<div class="details-card">
    <div class="details-card-title d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Detalii Programare</span>
    </div>
    
    <div class="px-2">
        <div class="row mb-4 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Pacient
            </div>
            <div class="col-sm-9 text-dark font-weight-bold fs-5">
                @Model.NumePacient
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Telefon
            </div>
            <div class="col-sm-9 text-dark">
                @Model.Telefon
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Doctor
            </div>
            <div class="col-sm-9 text-dark">
                @(Model.Doctor?.Nume ?? "-")
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Serviciu
            </div>
            <div class="col-sm-9">
                <span class="badge bg-light text-primary px-3 py-2 fs-6" style="border-radius: 6px; font-weight: 500;">
                    @(Model.Serviciu?.Nume ?? "-")
                </span>
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Sală
            </div>
            <div class="col-sm-9 text-dark">
                @(Model.Sala?.Nume ?? "-")
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Data
            </div>
            <div class="col-sm-9 text-dark font-weight-semibold">
                @Model.Data.ToString("dd.MM.yyyy HH:mm")
            </div>
        </div>
        
        <div class="row mb-3 align-items-center">
            <div class="col-sm-3 text-secondary font-weight-bold" style="font-weight: 600;">
                Status
            </div>
            <div class="col-sm-9">
                @{
                    var badgeClass = "bg-secondary";
                    if (Model.Status == "Confirmata" || Model.Status == "Confirmată") badgeClass = "bg-success text-white";
                    else if (Model.Status == "In asteptare" || Model.Status == "În așteptare" || Model.Status == "Pending") badgeClass = "bg-warning text-dark";
                    else if (Model.Status == "Anulata" || Model.Status == "Anulată" || Model.Status == "Cancelled") badgeClass = "bg-danger text-white";
                }
                <span class="badge @badgeClass px-3 py-2 fs-6" style="border-radius: 20px; font-weight: 600;">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Înapoi la Listă</span>
        </a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning d-inline-flex align-items-center gap-2 px-4 py-2" style="border-radius: 10px; color: #000;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Editează</span>
        </a>
    </div>
</div>
