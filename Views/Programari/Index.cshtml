@model IEnumerable<PawSpital.Models.Programare>
@{
    ViewData["Title"] = "Programări";
}
<h1>Listă Programări</h1>
<p><a asp-action="Create" class="btn btn-primary">Adaugă Programare</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Pacient</th><th>Telefon</th><th>Doctor</th><th>Serviciu</th><th>Sală</th><th>Data</th><th>Status</th><th>Acțiuni</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.NumePacient</td>
            <td>@p.Telefon</td>
            <td>@(p.Doctor?.Nume ?? "-")</td>
            <td>@(p.Serviciu?.Nume ?? "-")</td>
            <td>@(p.Sala?.Nume ?? "-")</td>
            <td>@p.Data.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@p.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@p.Id">Detalii</a> |
                <a asp-action="Edit" asp-route-id="@p.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

